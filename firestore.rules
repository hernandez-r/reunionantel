rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function esAdmin() {
      // Reemplazar por el UID exacto de Authentication; nunca por correo o contraseña.
      return request.auth != null
        && request.auth.uid == 'ZM7oO3DxIqYFWnGLYANS9s6Erar1';
    }

    function maxInvitados() {
      // Mantener sincronizado con EVENTO.maxInvitados en js/config.js (0 a 10).
      return 10;
    }

    function inscripcionAbierta() {
      // El plazo viene del mismo documento que lee la página pública.
      // Sin configuración, las altas públicas quedan cerradas por seguridad.
      let ruta = /databases/$(database)/documents/configuracion/evento;
      return exists(ruta)
        && request.time < get(ruta).data.limiteConfirmacion + duration.value(1, 'd');
    }

    function diaUruguayValido(fecha) {
      return fecha is timestamp
        && fecha >= timestamp.date(2020, 1, 1)
        && fecha < timestamp.date(2101, 1, 1)
        && fecha == fecha.date() + duration.value(3, 'h');
    }

    function textoEventoValido(texto, maximo) {
      return texto is string && texto.size() >= 3 && texto.size() <= maximo
        && texto.matches('^[^\\s]+( [^\\s]+)*$');
    }

    function configuracionValida(datos) {
      return datos.keys().hasAll(['nombre', 'lugar', 'fecha', 'limiteConfirmacion', 'limitePago', 'ticketCentavos', 'actualizadoEn'])
        && datos.keys().hasOnly(['nombre', 'lugar', 'fecha', 'limiteConfirmacion', 'limitePago', 'ticketCentavos', 'actualizadoEn'])
        && textoEventoValido(datos.nombre, 120)
        && textoEventoValido(datos.lugar, 180)
        && diaUruguayValido(datos.fecha)
        && diaUruguayValido(datos.limiteConfirmacion)
        && diaUruguayValido(datos.limitePago)
        && datos.limiteConfirmacion <= datos.limitePago
        && datos.limitePago <= datos.fecha
        && datos.ticketCentavos is int
        && datos.ticketCentavos >= 0 && datos.ticketCentavos <= 100000000
        && datos.actualizadoEn is timestamp
        && datos.actualizadoEn == request.time;
    }

    match /configuracion/evento {
      // Solo estos datos del evento son públicos; nunca las inscripciones.
      allow get: if true;
      allow create, update: if esAdmin() && configuracionValida(request.resource.data);
      allow list, delete: if false;
    }

    function nombreValido(nombre) {
      return nombre is string
        && nombre.size() >= 3 && nombre.size() <= 120
        && nombre.matches('^[^\\s]+( [^\\s]+)+$');
    }

    function invitadoValido(invitado) {
      return invitado is map
        && invitado.keys().hasAll(['nombre', 'tipo'])
        && invitado.keys().hasOnly(['nombre', 'tipo'])
        && nombreValido(invitado.nombre)
        && invitado.tipo is string
        && invitado.tipo in ['mayor', 'menor'];
    }

    function invitadoEnPosicionValido(invitados, indice) {
      return invitados.size() <= indice || invitadoValido(invitados[indice]);
    }

    function invitadosValidos(invitados) {
      // Rules no admite bucles: validar explícitamente TODOS los elementos permitidos.
      // Aumentar el máximo por encima de 10 exige extender esta validación.
      return invitados is list && invitados.size() <= maxInvitados()
        && invitados.size() <= 10
        && invitadoEnPosicionValido(invitados, 0)
        && invitadoEnPosicionValido(invitados, 1)
        && invitadoEnPosicionValido(invitados, 2)
        && invitadoEnPosicionValido(invitados, 3)
        && invitadoEnPosicionValido(invitados, 4)
        && invitadoEnPosicionValido(invitados, 5)
        && invitadoEnPosicionValido(invitados, 6)
        && invitadoEnPosicionValido(invitados, 7)
        && invitadoEnPosicionValido(invitados, 8)
        && invitadoEnPosicionValido(invitados, 9);
    }

    function datosValidos(datos) {
      return datos.keys().hasAll(['titular', 'invitados', 'pagado', 'fechaRegistro'])
        && datos.keys().hasOnly(['titular', 'invitados', 'pagado', 'fechaRegistro'])
        && nombreValido(datos.titular)
        && invitadosValidos(datos.invitados)
        && datos.pagado is bool
        && datos.fechaRegistro is timestamp;
    }

    match /inscripciones/{inscripcionId} {
      allow get, list: if esAdmin();
      allow create: if inscripcionId.matches('^[a-zA-Z0-9]{20}$')
        && datosValidos(request.resource.data)
        && request.resource.data.fechaRegistro == request.time
        && (esAdmin() || (inscripcionAbierta() && request.resource.data.pagado == false));
      allow update: if esAdmin()
        && datosValidos(request.resource.data)
        && request.resource.data.fechaRegistro == resource.data.fechaRegistro;
      allow delete: if esAdmin();
    }

    // Incluye futuras subcolecciones: nada se habilita implícitamente.
    match /{documento=**} {
      allow read, write: if false;
    }
  }
}
